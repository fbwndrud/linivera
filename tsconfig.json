{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": false,
    "module": "nodenext", "moduleResolution": "nodenext", "target": "es2023",
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["core/**/*.js", "packs/**/*.js", "server/**/*.js", "bin/**/*.js", "adapters/production/**/*.js"]
}
